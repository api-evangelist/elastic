  "dcterms:source": [
    "openapi/elastic-account-api-openapi.yml",
    "openapi/elastic-cluster-api-openapi.yml",
    "openapi/elastic-data-views-api-openapi.yml",
    "openapi/elastic-deployments-api-openapi.yml",
    "openapi/elastic-documents-api-openapi.yml"
  ]
}