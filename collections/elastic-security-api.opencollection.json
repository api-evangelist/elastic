{
  "opencollection": "1.0.0",
  "info": {
    "name": "Elastic Cloud Account Security API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Security",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a security role",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.elastic-cloud.com/_security/role/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the named role definition. Roles can be assigned to users and API keys to grant cluster, index, and application privileges."
        }
      ]
    }
  ],
  "bundled": true
}