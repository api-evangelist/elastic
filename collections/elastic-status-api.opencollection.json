{
  "opencollection": "1.0.0",
  "info": {
    "name": "Elastic Cloud Account Status API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Kibana server status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.elastic-cloud.com/api/status"
          },
          "docs": "Get Kibana server status"
        }
      ]
    }
  ],
  "bundled": true
}