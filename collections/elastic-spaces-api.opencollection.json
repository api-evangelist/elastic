{
  "opencollection": "1.0.0",
  "info": {
    "name": "Elastic Cloud Account Spaces API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Spaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Kibana Spaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.elastic-cloud.com/api/spaces/space"
          },
          "docs": "List Kibana Spaces"
        }
      ]
    }
  ],
  "bundled": true
}